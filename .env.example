# Luck - AI Roulette Lab: local configuration
#
# Copy this file to ".env" (scripts/start.ps1 and scripts/start.sh do it for you) and edit .env.
# .env is ignored by git. NEVER commit .env and never paste real keys into this example file.
#
# API keys stay on the server: they are never sent to the browser, and they are redacted
# from logs, error messages and exports. Every setting is optional; an empty value means
# "use the default". Restart Luck after changing .env.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------- server
# Address the server listens on. Must be a loopback address: 127.0.0.1, ::1 or localhost.
# Anything else (0.0.0.0, a LAN address, a host name) is refused - Luck is local only.
LUCK_HOST=127.0.0.1
# Port for the API and for the one-port production app (npm start -> http://127.0.0.1:3717).
LUCK_PORT=3717
# Port for the development web UI (npm run dev -> http://127.0.0.1:5717).
LUCK_WEB_PORT=5717
# Folder for the SQLite database (luck.db): sessions, rounds, decisions, usage.
# Relative paths are relative to the Luck folder, not to the current directory.
LUCK_DATA_DIR=data
# Set to 1 to also accept the development web UI origin when NODE_ENV=production.
LUCK_DEV=

# ---------------------------------------------------------------- Ollama (local, no cloud charge)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional default model name exactly as "ollama list" shows it. You can also pick one in the app.
OLLAMA_MODEL=

# ---------------------------------------------------------------- Anthropic Messages API (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional default model id. You can also type one in the app.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------- OpenAI-compatible endpoint
# There is no default endpoint: write the full base URL you want to call, including /v1 if the
# service needs it. It can be a paid cloud API or a local server.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ---------------------------------------------------------------- Claude Code CLI (optional)
# Absolute path to the native claude executable (claude.exe on Windows; .cmd/.ps1 shims are refused).
# Empty = search PATH for the native binary.
CLAUDE_CLI_PATH=
# false = never offer the Claude Code CLI player.
CLAUDE_CLI_ENABLED=true
# Optional model alias or id passed to the CLI.
CLAUDE_CLI_MODEL=
# true = use the Claude Code login you already have (your subscription); ANTHROPIC_API_KEY is
# not passed to the CLI. false = the CLI is given ANTHROPIC_API_KEY instead.
CLAUDE_CLI_USE_SUBSCRIPTION=true

# ---------------------------------------------------------------- Laya (optional local classifier, laya-serve)
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_API_KEY=
# Checkpoint name: english, multilingual or typed-decisions.
LAYA_CHECKPOINT=english
